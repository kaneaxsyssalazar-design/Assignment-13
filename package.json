  "scripts": {
    "start": "PORT=8083 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --testMatch \"**/src/**/*.tests.tsx\"",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false --testMatch \"**/src/**/*.tests.tsx\"",
